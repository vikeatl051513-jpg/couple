page {
  min-height: 100%;
  background: #fff7fb;
  color: #24212b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1;
  border: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx);
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
}

.empty {
  padding: 60rpx 24rpx;
  color: #9d98aa;
  text-align: center;
  font-size: 28rpx;
}
