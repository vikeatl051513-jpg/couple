.anniversary-page {
  min-height: 100vh;
  background: #f7f8fa;
  color: #1f2330;
}

.page-content {
  height: 100vh;
  padding: 30rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  min-height: 360rpx;
  padding: 38rpx 34rpx;
  border-radius: 30rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b8a 0%, #8f76ed 100%);
  box-shadow: 0 18rpx 42rpx rgba(143, 118, 237, 0.24);
}

.hero-meta,
.hero-days,
.next-pill {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-desc {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-days {
  margin-top: 34rpx;
  display: flex;
  align-items: baseline;
}

.hero-num {
  font-size: 88rpx;
  font-weight: 900;
  line-height: 0.95;
}

.hero-unit {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.next-pill {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #7d4d6a;
  background: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 900;
}

.section-head {
  margin: 34rpx 2rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #1f2330;
  font-size: 32rpx;
  font-weight: 900;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #9aa0ad;
  font-size: 23rpx;
}

.add-btn,
.empty-action {
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #ffffff;
  background: #1f2330;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-card,
.anniversary-card {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(35, 38, 47, 0.03);
}

.empty-card {
  padding: 42rpx 34rpx;
}

.empty-title {
  color: #1f2330;
  font-size: 31rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #9097a5;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-action {
  width: 210rpx;
  margin-top: 28rpx;
  background: #8f76ed;
}

.anniversary-card {
  min-height: 138rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}

.anniversary-card.important {
  border: 2rpx solid rgba(255, 107, 138, 0.28);
}

.card-left {
  min-width: 0;
  flex: 1;
}

.card-name {
  color: #1f2330;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-date {
  margin-top: 12rpx;
  color: #8f96a3;
  font-size: 24rpx;
}

.card-right {
  flex: 0 0 auto;
  text-align: right;
}

.countdown {
  color: #ff5c7c;
  font-size: 28rpx;
  font-weight: 900;
}

.badge {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  margin-left: auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8f76ed;
  background: #f3efff;
  font-size: 21rpx;
  font-weight: 900;
}

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 16, 24, 0.5);
}

.anniversary-sheet {
  width: 100%;
  padding: 20rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  box-sizing: border-box;
  background: #ffffff;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #ded9e6;
}

.sheet-title {
  margin-bottom: 28rpx;
  color: #1f2330;
  font-size: 36rpx;
  font-weight: 900;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 900;
}

.form-input {
  width: 100%;
  height: 82rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  background: #f7f8fb;
  color: #1f2330;
  font-size: 29rpx;
  box-sizing: border-box;
}

.date-input {
  display: flex;
  align-items: center;
}

.form-row {
  min-height: 90rpx;
  padding: 4rpx 0 22rpx;
  border-bottom: 1rpx solid #edf0f4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.form-row-title {
  color: #1f2330;
  font-size: 28rpx;
  font-weight: 900;
}

.form-row-desc {
  margin-top: 8rpx;
  color: #9aa0ad;
  font-size: 23rpx;
}

.sheet-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.danger-btn,
.ghost-btn,
.submit-btn {
  height: 84rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.danger-btn::after,
.ghost-btn::after,
.submit-btn::after {
  border: 0;
}

.danger-btn {
  flex: 0 0 132rpx;
  color: #ff4d6d;
  background: #fff0f4;
}

.ghost-btn {
  flex: 1;
  color: #8f76ed;
  background: #f3efff;
}

.submit-btn {
  flex: 1.4;
  color: #ffffff;
  background: #8f76ed;
}
