.dress-page {
  min-height: 100vh;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
}

.preview-card,
.checkin-card,
.dress-card {
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 46rpx rgba(88, 76, 120, 0.1);
}

.preview-card {
  padding: 28rpx;
  border-radius: 30rpx;
}

.preview-head,
.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  display: block;
  color: #1d1827;
  font-size: 42rpx;
  font-weight: 900;
}

.subtitle,
.section-subtitle,
.dress-price {
  display: block;
  margin-top: 8rpx;
  color: #8f899d;
  font-size: 25rpx;
}

.points {
  min-width: 118rpx;
  height: 98rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #756f9d;
  background: #f5f1fb;
  font-weight: 900;
}

.points text:first-child {
  font-size: 34rpx;
}

.points text:last-child {
  font-size: 22rpx;
}

.sample-menu {
  display: flex;
  gap: 18rpx;
  height: 190rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
}

.sample-side {
  width: 92rpx;
  border-radius: 18rpx;
  background: rgba(127, 117, 156, 0.12);
}

.sample-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
}

.sample-line {
  width: 60%;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(45, 41, 53, 0.14);
}

.sample-line.wide {
  width: 82%;
}

.sample-button {
  width: 132rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

.checkin-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
}

.section-title {
  color: #1d1827;
  font-size: 31rpx;
  font-weight: 900;
}

.checkin-btn {
  width: 132rpx;
  height: 68rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.checkin-btn[disabled] {
  color: #aaa4b8;
  background: #eeeaf4 !important;
}

.list-title {
  display: block;
  margin: 30rpx 0 18rpx;
}

.dress-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.dress-card {
  padding: 18rpx;
  border-radius: 24rpx;
}

.dress-preview {
  height: 156rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.rarity {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(29, 24, 39, 0.38);
  font-size: 22rpx;
  font-weight: 900;
}

.dress-name {
  display: block;
  margin-top: 16rpx;
  color: #1d1827;
  font-size: 28rpx;
  font-weight: 900;
}

.apply-btn,
.owned-btn,
.buy-btn {
  width: 100%;
  height: 62rpx;
  margin-top: 14rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.apply-btn {
  color: #ffffff;
}

.owned-btn {
  color: #756f9d;
  background: #f2eef8;
}

.buy-btn {
  color: #6d4b18;
  background: #fff1d2;
}
