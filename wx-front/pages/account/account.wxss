.account-page {
  min-height: 100vh;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  color: #333333;
}

.account-card,
.hint-card,
.invite-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 20, 36, 0.04);
}

.account-card {
  padding: 34rpx;
}

.login-panel {
  padding-top: 42rpx;
}

.account-title {
  color: #211d2f;
  font-size: 36rpx;
  font-weight: 900;
}

.account-subtitle {
  margin-top: 10rpx;
  color: #9c96aa;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-visual {
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.phone-badge {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f0fc;
}

.phone-screen {
  width: 74rpx;
  height: 110rpx;
  border-radius: 20rpx;
  border: 8rpx solid #211d2f;
  box-sizing: border-box;
  background: #ffffff;
}

.phone-check {
  position: absolute;
  right: 30rpx;
  bottom: 28rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #24c08b;
  font-size: 28rpx;
  font-weight: 900;
}

.login-slogan {
  margin-top: 38rpx;
  color: #211d2f;
  font-size: 38rpx;
  font-weight: 900;
}

.login-note {
  margin-top: 14rpx;
  color: #928b9d;
  font-size: 24rpx;
  line-height: 1.6;
}

.phone-login-btn {
  height: 92rpx;
  margin: 86rpx 0 0;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #1f1f21;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.phone-login-btn::after {
  border: 0;
}

.phone-login-btn[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: #5f5f64;
}

.login-skip {
  margin-top: 30rpx;
  color: #b3adbd;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-preview {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-preview {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #9b88ed;
  background: #f3f0fc;
  font-size: 40rpx;
  font-weight: 900;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-meta {
  min-width: 0;
  flex: 1;
}

.nickname-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #211d2f;
  background: #f8f7fb;
  font-size: 30rpx;
  font-weight: 800;
}

.login-state {
  margin-top: 12rpx;
  color: #9b88ed;
  font-size: 24rpx;
  font-weight: 700;
}

.form-actions {
  margin-top: 34rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.avatar-btn,
.primary-btn,
.danger-btn {
  height: 82rpx;
  margin: 0;
  border-radius: 24rpx;
  flex: 1;
  min-width: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.avatar-btn::after,
.primary-btn::after,
.danger-btn::after {
  border: 0;
}

.avatar-btn {
  color: #9b88ed;
  background: #f3f0fc;
}

.primary-btn {
  color: #ffffff;
  background: #9b88ed;
  box-shadow: 0 10rpx 24rpx rgba(155, 136, 237, 0.28);
}

.danger-btn {
  color: #ff4d6d;
  background: #fff0f4;
}

.hint-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.invite-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.hint-title {
  color: #211d2f;
  font-size: 28rpx;
  font-weight: 900;
}

.hint-text {
  margin-top: 10rpx;
  color: #928b9d;
  font-size: 24rpx;
  line-height: 1.6;
}

.invite-form {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.invite-input {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #211d2f;
  background: #f8f7fb;
  font-size: 28rpx;
  font-weight: 800;
}

.invite-bind-btn {
  width: 144rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #9b88ed;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.invite-bind-btn::after {
  border: 0;
}
